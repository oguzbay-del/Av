        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast small duck: long lead; head and upper chest."
          }
        }
      }
    },
    "Hızlı ve yan/önden geçer: kuşun önüne uzun pay verin, tüfeği durdurmadan sallayın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast, crossing or incoming: give a long lead in front of the bird and keep the gun swinging."
