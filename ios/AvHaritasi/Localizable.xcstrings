    "Yasak alana girdiğinizde uyarabilmek için konumunuz gerekir. Konum geçmişi yalnızca iz kaydını başlatırsanız cihazda saklanır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is needed to alert you when you enter a no-hunting area. Location history is stored on the device only if you start track recording."
          }
        }
      }
    },
    "Yasak alana, köye ya da karayoluna yaklaştığınızda uyarmak için": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To alert you when you approach a no-hunting area, a village or a highway"
          }
        }
      }
    },
    "Yasak alanlardan uzak: pil tasarrufu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Far from no-hunting areas: battery saving"
