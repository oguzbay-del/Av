            "value": "Çatalca Çilingoz"
          }
        }
      }
    },
    "Çekmeyen yerlerde de harita görünsün diye ayrıntılı topoğrafik haritayı Wi-Fi'deyken indirin (en çok 150 MB).": {
      "extractionState": "manual",
      "localizations": {
