    "Sulak alan / göl kıyısı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetland / lakeside"
          }
        }
      }
    },
    "Sulak alanda kurşunsuz (çelik, bizmut, tungsten) saçma etik öneridir; yasal zorunluluk değildir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In wetlands non-toxic shot (steel, bismuth, tungsten) is an ethical recommendation, not a legal requirement."
          }
        }
      }
    },
    "Sulak alanda kurşunsuz saçma etik öneri.": {
