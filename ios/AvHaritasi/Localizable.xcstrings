          }
        }
      }
    },
    "Cihazdaki genel sınıflandırıcı kullanıldı; tür değil grup verir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The general on-device classifier was used; it names the group, not the species."
          }
        }
      }
    },
    "Cihazdaki model emin değil — internete soruluyor (%@)…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device model is unsure — asking online (%@)…"
          }
        }
      }
    },
    "Cihazdaki model emin olmadığında ya da tür bulamadığında ve internet varken yalnızca seçtiğiniz fotoğraf ya da 5–30 sn'lik ses kaydı Google Cloud sunucularındaki tanıma modeline (fotoğraf: BioCLIP 2, ses: Perch v2) gönderilir. Konum ve başka bir bilgi gönderilmez; fotoğraf ya da kayıt yalnızca tahmin için işlenir, saklanmaz. Kapalıyken tanıma yalnızca cihazda yapılır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the on-device model is unsure or finds no species and you are online, only the photo you chose or the 5–30 s sound recording is sent to an identification model on Google Cloud servers (photo: BioCLIP 2, sound: Perch v2). No location or other information is sent; the photo or recording is processed only for the prediction and is not stored. When off, identification runs on the device only."
          }
        }
      }
    },
