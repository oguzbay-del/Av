            "value": "Satellite"
          }
        }
      }
    },
    "Uydu + yol": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Satellite + roads"
          }
        }
      }
    },
    "Uygulama": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
