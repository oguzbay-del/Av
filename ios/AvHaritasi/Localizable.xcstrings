    "Kayıt yok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entries"
          }
        }
      }
    },
    "Kayıtlar yalnızca bu cihazda tutulur. Limit dolunca + düğmesi kapanır. Ördekler için grup toplamı (6) ve tür sınırları birlikte uygulanır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries are stored only on this device. The + button is disabled when the limit is reached. For ducks the group total (6) and per-species limits apply together."
          }
        }
      }
    },
    "Kayıtlı izler": {
      "extractionState": "manual",
