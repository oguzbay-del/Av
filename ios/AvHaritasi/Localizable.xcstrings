    "Av Haritası": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Av Haritası"
          }
        }
      }
    },
    "Av Haritası kilitli": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Av Haritası is locked"
          }
        }
      }
    },
    "Av Haritası yardımcı bir araçtır; yasal sorumluluk avcıdadır. Sınırlar birkaç yüz metre sapabilir: sınıra yakınsanız ve emin değilseniz avlanmayın. Yeşil durum; avcılık belgesi, izin kartı, AVBİS izni ve tür limitleri gibi yükümlülükleri kaldırmaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Av Haritası is a helper tool; legal responsibility lies with the hunter. Boundaries may be off by a few hundred metres: if you are near a boundary and unsure, do not hunt. A green status does not replace your hunting licence, permit card, AVBİS permit or species limits."
          }
        }
      }
    },
