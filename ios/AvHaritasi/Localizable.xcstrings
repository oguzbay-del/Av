          }
        }
      }
    },
    "Mobil şok namlu ağzına vidalanır ve değiştirilebilir. Sabit şoklu namluda şok değişmez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interchangeable chokes screw into the muzzle and can be changed. A fixed-choke barrel cannot be changed."
          }
        }
      }
    },
