    },
    "Av; avcılık belgesi ve Merkez Av Komisyonu kararındaki gün, tür ve kotalara uyulması şartıyla yapılabilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunting is allowed with a hunting licence, following the days, species and quotas of the Central Hunting Commission decision."
          }
        }
      }
    },
    "Av; avcılık belgesi, avlanma izin kartı ve Merkez Av Komisyonu kararındaki gün, tür ve kotalara uyulması şartıyla yapılabilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunting is allowed with a hunting licence and hunting permit card, following the days, species and quotas of the Central Hunting Commission decision."
          }
        }
      }
    },
    "Ava Yasak Alan": {
      "extractionState": "manual",
      "localizations": {
