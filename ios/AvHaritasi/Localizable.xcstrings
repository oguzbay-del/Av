{
  "sourceLanguage": "tr",
  "strings": {
    "\"Durumu kilit ekranında göster\" açıkken av durumu ve rüzgâr kilit ekranında, Dynamic Island'da ve Apple Watch'ta görünür. Ana ekrana Av durumu aracını ekleyebilir, Siri'ye \"Av Haritası burada avlanabilir miyim\" ya da \"Av Haritası av saati\" diyebilirsiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With \"Show status on Lock Screen\" on, the hunting status and wind appear on the Lock Screen, in the Dynamic Island and on Apple Watch. You can add the Hunting status widget to your Home Screen and ask Siri \"Can I hunt here with Av Haritası\" or \"Av Haritası hunting hours\"."
          }
        }
      }
    },
