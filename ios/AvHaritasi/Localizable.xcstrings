    },
    "Tahmin bir yardımdır, kesin teşhis değildir. Türden emin olmadan atış yapmayın; koruma altındaki türler av türlerine benzeyebilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prediction is an aid, not a definitive identification. Do not shoot unless you are sure of the species; protected species can look like game species."
          }
        }
      }
    },
    "Tahmin bir yardımdır, kesin teşhis değildir. Türden emin olmadan atış yapmayın; koruma altındaki türler ses olarak av türlerine benzeyebilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prediction is an aid, not a definitive identification. Do not shoot unless you are sure of the species; protected species can sound like game species."
