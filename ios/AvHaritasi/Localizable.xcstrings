    "Tüfek çelik saçmaya uygun mu?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is the gun steel-proof?"
          }
        }
      }
    },
    "Tüfek çeliğe uygun değil: kurşun önerildi. Kurşunsuz istiyorsanız bizmut ya da tungsten kullanın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gun is not steel-proof: lead recommended. For non-toxic shot use bismuth or tungsten."
          }
        }
      }
    },
    "Tüfeklerim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My guns"
          }
        }
      }
    },
    "Tüfekleriniz yalnızca bu telefonda saklanır; Bugün › Ava hazırlık bunlara göre şok ve saçma önerir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your guns are stored only on this phone; Today › Hunt preparation suggests chokes and shot based on them."
          }
        }
      }
    },
    "Tüfeğe bir ad verin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the gun a name"
          }
        }
      }
    },
    "Tüfeği düzenle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit gun"
          }
        }
      }
    },
    "Tüfeği sil": {
