          "stringUnit": {
            "state": "translated",
            "value": "Dead Sea Sparrow"
          }
        }
      }
    },
    "Küçük suçulluğu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack Snipe"
          }
        }
      }
    },
    "Küçük tarla kazı": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pink-footed Goose"
          }
        }
      }
    },
    "Kılavuz internetsiz de açılır. Geri bildirimle hata, öneri ya da harita düzeltmesini geliştiriciye iletebilirsiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide works offline too. Use feedback to send a bug, a suggestion or a map correction to the developer."
          }
        }
      }
    },
    "Kılavuza Ayarlar › Yardım'dan ulaşırsınız; internetsiz çalışır, üstteki arama kutusuyla konu bulabilirsiniz. İlk açılıştaki tanıtım sayfalarını da buradan yeniden açabilirsiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this guide from Settings › Help; it works without internet and you can find topics with the search field at the top. You can also replay the welcome pages from the first launch here."
          }
        }
      }
    },
    "Kılavuzda ara": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search the guide"
          }
        }
      }
    },
    "Kılkuyruk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Northern Pintail"
          }
        }
      }
    },
    "Kılkuyruk bağırtlak": {
