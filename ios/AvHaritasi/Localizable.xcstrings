      }
    },
    "Yasak tüfek ve fişek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banned guns and cartridges"
          }
        }
      }
    },
    "Yasal 300/500 m kuralları her zaman uygulanır. Buradaki mesafe, ava yasak alanlara ve yaklaşık çizilen sınırlara ek temkin payıdır. Zaman kuralları açıkken av günü, av saati ve sezon da ana durumu etkiler.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legal 300/500 m rules always apply. This distance is an extra safety margin around no-hunting areas and approximate boundaries. With time rules on, hunting day, hours and season also affect the main status."
          }
        }
      }
    },
    "Yeni yaban hayvanı yerleştirme sahaları": {
      "extractionState": "manual",
