    },
    "Av köpeği eğitimi sezon içinde av günleri ve zamanında yapılabilir; sezon dışında DKMP izni gerekir. Avlaklara kedi ve köpek başıboş bırakılamaz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunting dog training is allowed in season on hunting days and hours; out of season it needs DKMP permission. Cats and dogs may not be left to roam in hunting areas."
          }
        }
      }
    },
