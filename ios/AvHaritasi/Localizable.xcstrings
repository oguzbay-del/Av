        }
      }
    },
    "Konum yalnızca cihazda işlenir; iz kaydını siz başlatmazsanız konum geçmişi tutulmaz. Hava tahmini için yalnızca yaklaşık konum paylaşılır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is processed on the device; no location history is kept unless you start track recording. Only an approximate location is shared for the weather forecast."
          }
        }
      }
    },
    "Konum yok; İstanbul merkezine göre hesaplandı.": {
