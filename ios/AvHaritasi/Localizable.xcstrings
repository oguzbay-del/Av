    "Askeri alan / tesis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Military area / facility"
          }
        }
      }
    },
    "Askeri yapı ve tesisler, silah atış ve tatbikat sahaları, mühimmat depoları, nükleer/doğalgaz tesisleri, huzurevi, eğitim, sağlık, spor tesisleri, kamplar, cezaevleri ve özel avlak sınırlarına 500 m içinde avlanmak yasaktır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunting is banned within 500 m of military buildings and facilities, firing and training ranges, ammunition depots, nuclear/natural gas facilities, nursing homes, educational, health and sports facilities, camps, prisons and private hunting area boundaries."
          }
        }
      }
    },
    "Atla": {
