            "state": "translated",
            "value": "Semi-automatics and pumps need a magazine plug: at most 2+1 shells (MAK 10/1-a)."
          }
        }
      }
    },
    "Yarı otomatik ve pompalıda zorunlu (MAK 10/1-a).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
