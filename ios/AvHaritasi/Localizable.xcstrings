            "state": "translated",
            "value": "Golden jackal"
          }
        }
      }
    },
    "Çalı arasından kısa uçar: hızlı karar; köpek ve arkadaki kişilere dikkat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
