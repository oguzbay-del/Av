    "Nokta: haritada uzun bastığınız yer, yoksa haritanın ortası. 4 ondalığa (~11 m) yuvarlanır; GPS konumunuz gönderilmez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point: where you long-pressed on the map, otherwise the map centre. Rounded to 4 decimals (~11 m); your GPS location is not sent."
          }
        }
      }
    },
