          }
        }
      }
    },
    "Namlu boyu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrel length"
          }
        }
      }
    },
    "Namlu boyu bu arazi için uygun.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrel length suits this terrain."
          }
        }
      }
    },
    "Namlu bu arazi için kısa; uzak atışta salınım zorlaşır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrel is short for this terrain; a smooth swing is harder at long range."
          }
        }
      }
    },
    "Namlu bu arazi için uzun; çalıda hızlı dönüşü zorlaştırır.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrel is long for this terrain; quick swings in cover are harder."
          }
        }
      }
    },
    "Namlu üzerinde ya da kundak altında yazar (ör. \"12\", \"20\"). Türkiye'de en yaygını 12.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked on the barrel or under the stock (e.g. \"12\", \"20\"). 12 is the most common in Türkiye."
          }
        }
      }
    },
    "Namlu üzerinde yazar: 70 mm (2¾\"), 76 mm magnum (3\"), 89 mm süper magnum (3½\"). Uygulama yataktan uzun fişek önermez.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked on the barrel: 70 mm (2¾\"), 76 mm magnum (3\"), 89 mm super magnum (3½\"). The app never recommends shells longer than the chamber."
          }
        }
      }
    },
    "Namluda": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the barrel"
          }
        }
      }
    },
    "Namluda \"STEEL\" yazısı ya da zambak (fleur-de-lys) biçimli çelik muayene damgası varsa uygundur. Emin değilseniz \"Bilmiyorum\" seçin: uygulama çelik önermez, kurşun önerir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is suitable if the barrel has \"STEEL\" or a fleur-de-lys steel-proof stamp. If unsure choose \"Don't know\": the app will recommend lead, not steel."
          }
        }
      }
    },
    "Namluda çelik damgası var.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The barrel has a steel-proof stamp."
          }
        }
      }
    },
    "Namlunun şoku": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrel choke"
          }
        }
      }
    },
    "Ne avlayacağınızı seçin; uygulama tüfeğinizi, şokunuzu ve saçmanızı önersin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what you will hunt; the app will suggest your gun, choke and shot."
          }
        }
      }
    },
