          }
        }
      }
    },
    "Kınalı keklik": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chukar"
          }
        }
      }
    },
    "Kınalı keklik + Kum kekliği": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chukar + See-see partridge"
          }
        }
      }
    },
    "Kırmızı bantlar (isteğe bağlı)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red bands (optional)"
          }
        }
      }
    },
    "Kısa namlu (56–66 cm) çalı ve çullukta hızlıdır; uzun namlu (71–76 cm) geçit ve su kuşunda salınımı düzgün yapar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short barrel (56–66 cm) is quick in cover and for woodcock; a long barrel (71–76 cm) swings smoothly on flight lines and waterfowl."
          }
        }
      }
    },
    "Kısa namlu sürekte hızlı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short barrel is quick in driven hunts."
          }
        }
      }
    },
    "Kısa ve ani atış: şoku bir açın (ör. 3 → 4). Ağır gramaj gereksiz; hafif ve kısa namlu avantajlı.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short, sudden shots: open the choke one step (e.g. 3 → 4). Heavy loads are unnecessary; a light, short barrel helps."
          }
        }
      }
    },
    "Kızkuşu": {
      "extractionState": "manual",
      "localizations": {
