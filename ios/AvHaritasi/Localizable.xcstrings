        }
      }
    },
    "Henüz izin belgesi yok. AVBİS'ten aldığınız avlanma izin belgesinin ekran görüntüsünü ya da PDF'ini ekleyin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No permits yet. Add a screenshot or PDF of the hunting permit you got from AVBİS."
          }
        }
      }
    },
    "Henüz işaret yok. Alt paneldeki “İşaret koy” ya da haritada uzun basarak ekleyin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
