    "Henüz av durumu yok. Av Haritası'nı bir kez açıp konum izni verin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hunting status yet. Open Av Haritası once and allow location access."
