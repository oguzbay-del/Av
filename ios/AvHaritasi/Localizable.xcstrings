          "stringUnit": {
            "state": "translated",
            "value": "Brenneke-type slug; sabot in rifled barrels/paradox chokes. Not fired through chokes 1–2–3 (app rule). Without sights (bead only) at most ~35 m."
          }
        }
      }
    },
