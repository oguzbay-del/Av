        }
      }
    },
    "Sürü hâlinde hızlı geçer: tek kuşa seçerek nişan alın, sürüye atmayın.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passes fast in flocks: pick a single bird, don't shoot into the flock."
