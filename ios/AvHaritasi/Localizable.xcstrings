    "Yaban domuzu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wild boar"
          }
        }
      }
    },
    "Yaban domuzu için 5 (silindir), 4 ya da paradoks şoklu yivsiz tüfek ya da en az 6,5 mm yivli tüfek gerekir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wild boar needs a smoothbore with choke 5 (cylinder), 4 or a paradox choke, or a rifle of at least 6.5 mm."
          }
