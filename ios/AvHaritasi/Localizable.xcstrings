      }
    },
    "Konum alınamıyor. Haritada bir noktaya uzun basarak da işaret koyabilirsiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location unavailable. You can also drop a waypoint by long-pressing a point on the map."
